  "devDependencies": {
    "@wordpress/block-editor": "^14",
    "@wordpress/blocks": "^14",
    "@wordpress/env": "^10",
    "@wordpress/i18n": "^5",
    "@wordpress/scripts": "^30.18.0",
    "style-loader": "^4.0.0",
    "uglify-js": "^3.17.4"
  },
  "dependencies": {
