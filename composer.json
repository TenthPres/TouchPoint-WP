{
  "name": "tenthpres/touchpoint-wp",
  "description": "A WordPress Plugin for integrating with TouchPoint Church Management Software.",
  "license": "AGPL-3.0-or-later",
  "type": "wordpress-plugin",
  "version": "0.2.1",
  "keywords": [
    "wordpress",
    "wp",
    "TouchPoint",
    "ChMS",
    "Church Management"
  ],
  "authors": [
    {
      "name": "James K.",
      "email": "jkrrv@jkrrv.org"
    }
  ],
  "support": {
    "issues": "https://github.com/TenthPres/TouchPoint-WP/issues"
  },
  "autoload": {
    "psr-4": {
      "tp\\TouchPointWP\\": "src/TouchPoint-WP",
      "tp\\TouchPointWP\\Utilities\\": "src/TouchPoint-WP/Utilities",
      "tp\\TouchPointWP\\Interfaces\\": "src/TouchPoint-WP/Interfaces"
    }
  },
  "require": {
    "php": ">=8.0",
    "composer/installers": "^2.0",
    "ext-json": "*",
    "ext-zip": "*",
    "ext-dom": "*",
    "ext-libxml": "*"
  },
  "autoload-dev": {
    "psr-4": {
      "tp\\TouchPointWP\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "pronamic/wp-documentor": "^1.3",
    "saggre/phpdocumentor-markdown": "^1.0",
    "phpunit/phpunit": "^9.5",
    "yoast/phpunit-polyfills": "^1.0",
    "wp-phpunit/wp-phpunit": "^7.1",
    "johnpbloch/wordpress-core": "^7.1",
    "phpunit/phpcov": "^8.2"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "johnpbloch/wordpress-core-installer": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-wp": "bash bin/test-wp.sh",
    "test-coverage": "phpunit --coverage-html coverage"
  }
}
